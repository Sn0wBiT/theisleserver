NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
QUEST_API_URL=http://127.0.0.1:31990
QUEST_API_TOKEN=replace-with-the-bridge-api-token
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=true
PUBLIC_APP_URL=https://dino.example.com
DATABASE_URL=postgresql://tpn_web:password@127.0.0.1:5432/tpn
HUD_ACCESS_TOKEN_SECRET=replace-with-a-separate-32-character-secret
STEAM_WEB_API_KEY=
HUD_ORIGIN=https://dino.example.com
HUD_ACCESS_TOKEN_TTL_SECONDS=900
HUD_REFRESH_TOKEN_TTL_SECONDS=2592000
HUD_LOGIN_TTL_SECONDS=300
HUD_POLL_INTERVAL_SECONDS=3
HUD_START_RATE_LIMIT=10
HUD_POLL_RATE_LIMIT=120
